---
import type { Link } from "../models/Link";
import LinkButton from "./LinkButton.astro";

interface Props {
	class?: string;
	title: string;
	links: Link[];
}
---

<div class:list={[Astro.props.class, "bg-zinc-700/40 backdrop-blur-md  rounded-2xl"]}>
	<div class="flex justify-between items-center px-8 py-3">
		<h2>{Astro.props.title}</h2>
		<div class="flex gap-2">
			{Astro.props.links.map((l) => <LinkButton link={l} />)}
		</div>
	</div>
	<div class="h-px w-full bg-zinc-900"></div>
	<div class="px-8 py-6">
		<slot />
	</div>
</div>