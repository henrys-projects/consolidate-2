---
import Photo from "./Photo.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
	title: string;
	links: Array<Link>;
	images: string[];
}

interface Link {
	name: string;
	href: string;
}
---

<ProjectCard>
	<div class="flex items-center justify-between">
		<div>
			<h2 class="text-xl font-semibold mb-4">{Astro.props.title}</h2>

			<div class="flex flex-col lg:flex-row gap-3">
				{
					Astro.props.links.map((l) => (
						<a
							class="text-sm decoration-zinc-500  hover:decoration-zinc-400 transition-colors"
							href={l.href}
							target="_blank"
						>
							<div class="flex items-center gap-1 group">
								<p class="underline decoration-dotted underline-offset-5">
									{l.name}
								</p>
								<img
									src="icons/chevron-forward.png"
									class="size-4 group-hover:-rotate-45 transition-transform"
								/>
							</div>
						</a>
					))
				}
			</div>
		</div>
		<div class="flex gap-4">
			{Astro.props.images.map((i) => <Photo src={i} />)}
		</div>
	</div>
</ProjectCard>
