---
import type { Link } from "../models/Link";

interface Props {
	link: Link;
}

const backgroundColor = `color-mix(in hsl, ${Astro.props.link.color} 30%, transparent)`;
const outlineColor = `color-mix(in hsl, ${Astro.props.link.color} 30%, transparent)`;
---

<a
	class="block p-4 border border-zinc-800 rounded-full background-highlight"
	href={Astro.props.link.href}
	target="_blank"
>
	<img src={Astro.props.link.icon} class="size-5" />
</a>

<style define:vars={{ outlineColor, backgroundColor }}>
	@reference "tailwindcss";

	.background-highlight {
		@apply relative transition-colors overflow-hidden;
	}

	.background-highlight:hover {
		outline-color: var(--outlineColor);
	}

	.background-highlight::before {
		content: "";
		@apply absolute inset-0 opacity-0 transition-opacity;
		background: linear-gradient(
			45deg,
			var(--backgroundColor) 0%,
			transparent 100%
		);
	}

	.background-highlight:hover::before {
		@apply opacity-100;
	}
</style>
