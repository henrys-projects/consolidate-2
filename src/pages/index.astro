---
import DevelopmentProjectCard from "../components/DevelopmentProject.astro";
import Photo from "../components/Photo.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import Section from "../components/Section.astro";
import Page from "./_Page.astro";
---

<Page>
	<div
		class="flex flex-col justify-between gap-4 md:flex-row md:items-center md:pt-20"
	>
		<h1 class="font-(family-name:--font-display) text-6xl font-extrabold">
			Henry's<br />Projects<span class="text-teal-300">.</span>
		</h1>

		<div class="flex flex-col gap-1 md:text-end">
			<ul
				class="flex flex-wrap [&>*:not(:last-child)]:after:content-['•'] [&>*:not(:last-child)]:after:mx-2"
			>
				<li>London</li>
				<li>Software Engineer</li>
				<li>MMath</li>
			</ul>
			<a href="mailto:henry@henrysprojects.com" class="link-underline"
				>henry@henrysprojects.uk</a
			>
		</div>
	</div>

	<Section
		title="Development"
		links={[
			{
				icon: "icons/stack-overflow.png",
				color: "#ff5e00",
				href: "https://stackoverflow.com/users/10082297/henry",
			},
			{
				icon: "icons/github.png",
				color: "#0fbf3e",
				href: "https://github.com/henrys-projects",
			},
		]}
		class="mt-24"
	>
		<DevelopmentProjectCard
			title="Watch Roll"
			links={[
				{
					name: "Google Play",
					href: "https://play.google.com/store/apps/details?id=uk.henrysprojects.watchroll",
				},
				{
					name: "GitHub",
					href: "https://github.com/henrys-projects/watch-roll",
				},
			]}
			images={["projects/watch-roll/home.jpg", "projects/watch-roll/stats.jpg"]}
		/>
	</Section>

	<Section
		title="Photography"
		links={[
			{
				icon: "icons/glass.png",
				color: "#FFD60A",
				href: "https://glass.photo/henrysprojects",
			},
		]}
		class="mt-12"
	>
		<PhotoCarousel>
			<Photo src="projects/photography/matterhorn.jpg" />
			<Photo src="projects/photography/tromso.jpg" />
			<Photo src="projects/photography/dusky-leaf.jpg" />
			<Photo src="projects/photography/trwyn.jpg" />
			<Photo src="projects/photography/bern.jpg" />
		</PhotoCarousel>
	</Section>
</Page>