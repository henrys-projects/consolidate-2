---
import Font from "astro/components/Font.astro";
import Detail from "../components/Detail.astro";
import LinkCard from "../components/LinkCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Henry</title>

		<Font cssVariable="--font-default" />
	</head>
	<body
		class="bg-zinc-900 text-zinc-50 font-(family-name:--font-default) selection:bg-zinc-300/20"
	>
		<div class="lg:w-180 w-[80%] mx-auto mt-40 mb-20">
			<div class="flex flex-col lg:flex-row lg:justify-between lg:items-center">
				<h1 class="text-6xl lg:text-8xl font-semibold">
					Henry<span class="text-teal-300">.</span>
				</h1>

				<div class="flex flex-row lg:flex-col gap-x-4 gap-y-1 lg:gap-1 flex-wrap mt-4 lg:mt-0">
					<Detail icon="icons/location.png">London</Detail>
					<Detail icon="icons/university-of-bath.png">MMath</Detail>
					<Detail icon="icons/code.png">Software Engineer</Detail>
				</div>
			</div>

			<ul class="flex flex-col lg:flex-row lg:items-center gap-4 *:flex-1 mt-12 mb-24">
				<li>
					<LinkCard
						icon="icons/stack-overflow.png"
						title="Stack Overflow"
						color="#ff5e00"
						href="https://stackoverflow.com/users/10082297/henry-twist"
					/>
				</li>

				<li>
					<LinkCard
						icon="icons/github.png"
						title="GitHub"
						color="#0fbf3e"
						href="https://github.com/hctwist"
					/>
				</li>

				<li>
					<LinkCard
						icon="icons/email.png"
						title="Email me"
						color="#D9FCF5"
						href="mailto:henry@henrysprojects.com"
					/>
				</li>
			</ul>

			<div class="flex flex-col gap-4">
				<ProjectCard
					title="Photography"
					links={[
						{
							name: "Glass",
							href: "https://glass.photo/henrysprojects",
						}
					]}
					image="projects/photography.jpg"
				/>

				<ProjectCard
					title="Watch Roll"
					links={[
						{
							name: "Google Play",
							href: "https://play.google.com/store/apps/details?id=uk.henrytwist.watchroll",
						},
						{
							name: "GitHub",
							href: "https://github.com/hctwist/watch-roll",
						},
					]}
					image="projects/watch-roll.jpg"
				/>
			</div>
		</div>
	</body>
</html>
